# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
WATCHED_WALLETS=Valdora:wealth plug=0x1754fCD1F0EBb306286dd16F00abCf46731a92FC,NAWA:Wallet=0x3c7C22d108ddbD8190f3CAa3A5BCd99cBD8469e2

# Optional - health alerts go here (falls back to TELEGRAM_CHAT_IDS)
TELEGRAM_HEALTH_CHAT_IDS=

# RPC endpoints (defaults to free public nodes if not set)
ETH_RPC_URLS=https://eth.llamarpc.com,https://ethereum.publicnode.com,https://rpc.ankr.com/eth,https://cloudflare-eth.com
ETH_WS_URLS=wss://ethereum.publicnode.com

# Etherscan API key (free at etherscan.io) - used as fallback if RPC fails
ETHERSCAN_API_KEY=QRK6YUM3B6D7M5X65EQPY6FHIDZUBD49X1

# Token config (defaults are correct for ETH USDT)
TOKEN_SYMBOL=USDT
TOKEN_DECIMALS=6
MIN_ALERT_AMOUNT=1

# Monitoring
USE_WEBSOCKET=true
ALERT_INCOMING=true
ALERT_OUTGOING=true
POLL_INTERVAL_MS=10000
CONFIRMATIONS=1
MAX_BLOCK_RANGE=5
MAX_BACKLOG_BLOCKS=25

# Startup
ALERT_ON_STARTUP=true
START_FROM_LATEST_ON_BOOT=true
SEND_TEST_ALERTS_ON_STARTUP=false
SEND_RECENT_REAL_ALERTS_ON_STARTUP=false

# Health updates (every hour)
TELEGRAM_HEALTH_UPDATE_ENABLED=true
TELEGRAM_HEALTH_UPDATE_INTERVAL_MS=3600000
